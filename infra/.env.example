# Plantilla de infra/.env para producción. El archivo real NO se versiona (está en .gitignore).
# scripts/desplegar.sh lo crea solo la primera vez, con secretos aleatorios; este archivo
# sirve para documentar qué variables existen.

# Nombre DNS público de la VM; también es el rp-id de WebAuthn y el nombre del certificado TLS.
DOMINIO=clickclak-utp.chilecentral.cloudapp.azure.com

# Contraseña de Postgres. Generar con: openssl rand -hex 24
DB_PASSWORD=cambiar-por-un-valor-aleatorio

# Secreto HMAC de los JWT (mínimo 32 bytes). Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-valor-aleatorio-largo

# Contraseña del rol `replicador`, con el que la réplica de Postgres copia a la primaria.
# Generar con: openssl rand -hex 24
REPLICA_PASSWORD=cambiar-por-un-valor-aleatorio
