# Cómo se reenvía una petición de /api al backend. Se incluye dentro de cada location de la API.

proxy_pass http://backend:8080;
proxy_http_version 1.1;
# Conserva el puerto del origen. En el panel de administración, $host descartaría :8443 y
# Spring interpretaría su POST como una petición CORS externa, rechazando el login con 403.
proxy_set_header Host $http_host;

# El proxy es el borde: el cliente no puede falsear su IP. Se sustituye X-Forwarded-For en lugar
# de acumularlo ($proxy_add_x_forwarded_for), porque un valor enviado por el cliente no es confiable.
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $http_host;
proxy_set_header X-Forwarded-Port $server_port;

# Estas dos las añade la cabecera de seguridad del proxy; sin ocultarlas saldrían duplicadas.
proxy_hide_header X-Content-Type-Options;
proxy_hide_header X-Frame-Options;
